{
  "schemaVersion": 1,
  "id": "droidplay-hermes",
  "name": "DroidPlay Hermes",
  "version": "0.1.0",
  "author": "hey-dan123",
  "license": "MIT",
  "description": "Omarchy bar widget for DroidPlay status and Hermes strategy advice.",
  "homepage": "https://github.com/hey-dan123/droidplay-hermes",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "src/BarWidget.qml"
  },
  "barWidget": {
    "displayName": "DroidPlay Hermes",
    "description": "DroidPlay status, media controls, and bounded Hermes strategy advice.",
    "category": "Apps",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshSeconds": 15,
      "hermesTimeoutSeconds": 45,
      "droidplayCommand": "droidplay-adapter"
    },
    "schema": [
      {
        "key": "refreshSeconds",
        "type": "integer",
        "label": "Status refresh interval (seconds)",
        "min": 10,
        "max": 3600,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "hermesTimeoutSeconds",
        "type": "integer",
        "label": "Hermes timeout (seconds)",
        "min": 10,
        "max": 300,
        "step": 5,
        "defaultValue": 45
      },
      {
        "key": "droidplayCommand",
        "type": "string",
        "label": "DroidPlay adapter command",
        "defaultValue": "droidplay-adapter"
      }
    ]
  }
}
